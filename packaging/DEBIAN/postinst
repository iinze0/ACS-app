#!/bin/bash
set -e
mkdir -p /var/lib/acs-app
chmod 0755 /var/lib/acs-app
ln -sf /usr/bin/ACS-app /usr/bin/acs-app 2>/dev/null || true
if ! python3 -c "import tkinter" >/dev/null 2>&1; then
  echo "ACS app needs python3-tk: sudo apt-get install -y python3-tk" >&2
fi
update-desktop-database -q /usr/share/applications 2>/dev/null || true
exit 0
